# ============================================================
# Notion API 連携設定
# ============================================================
# .env.local にコピーして値をセットしてください。
# 未設定の場合は src/data/tasks-*.ts のハードコードデータで動作します。

# Notion Internal Integration の API キー
# https://www.notion.so/profile/integrations から発行
NOTION_API_KEY=

# 報告bot (n8n) と共有するエンジニアタスクDBのID
# DBページのURL: https://www.notion.so/<workspace>/<DB_ID>?v=...
# ハイフン無しの32文字、もしくはハイフン付きUUIDのいずれでも可
NOTION_TASKS_DB_ID=

# ============================================================
# Notion DB プロパティ名（src/lib/notion.ts の NOTION_PROPS と一致が必要）
# ============================================================
# 想定スキーマ:
#   名前              : title
#   開発ステータス    : status   (例: "完了" / "進行中" / "設計中" / "未着手")
#   担当者            : people   (Notionユーザー)
#   スケジュール      : date     (start + end の range)
#   進捗率            : number   (%表示 = 0–1 の小数で格納)
#   プロジェクト      : select   (例: "DIT" / "EA" / "Enlight Academy")
#
# プロジェクト slug → Notion select 値の対応は
# src/data/projects.ts の notionProjectNames で定義。
# 担当者の Notion名 → 略号 (VJ / EA 等) の変換は
# src/lib/notion.ts の ASSIGNEE_ALIAS で定義。
#
# Phase および 種別(task/milestone) はDB側に列が無いため、
# Notion由来のレコードは全て kind=task かつ project.phases[0] に紐づきます。
# マイルストーンは src/data/tasks-*.ts のハードコードを併用表示します。
