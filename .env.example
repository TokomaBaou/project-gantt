# ============================================================
# Notion API 連携設定
# ============================================================
# .env.local にコピーして値をセットしてください。
# 未設定の場合は src/data/tasks-*.ts のハードコードデータで動作します。

# Notion Internal Integration の API キー
# https://www.notion.so/profile/integrations から発行
NOTION_API_KEY=

# 報告bot (n8n) と共有するタスクDBのID
# DBページのURL: https://www.notion.so/<workspace>/<DB_ID>?v=...
# ハイフン無しの32文字、もしくはハイフン付きUUIDのいずれでも可
NOTION_TASKS_DB_ID=

# ============================================================
# Notion DB プロパティ名（src/lib/notion.ts の NOTION_PROPS と一致が必要）
# ============================================================
# 以下のプロパティを Notion DB に用意してください:
#   - タイトル        : title
#   - ステータス      : select   ("完了" / "進行中" / "FB待ち" / "予定" / "新規")
#   - 担当            : select または rich_text (例: "VJ", "EA", "VJ/EA")
#   - 開始日          : date
#   - 終了日          : date
#   - 進捗率          : number  (0-100)
#   - Phase           : select  (各プロジェクトのフェーズラベルに一致, 例 "Phase 1: FAQ bot")
#   - プロジェクト    : select  (値は slug: "ea", "dit", ...)
#   - 種別            : select  ("task" / "milestone" もしくは "タスク" / "マイルストーン")
