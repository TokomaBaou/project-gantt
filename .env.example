# ============================================================
# Notion API 連携設定
# ============================================================
# 未設定時は src/data/tasks-*.ts のハードコードデータで動作。

# Notion Internal Integration の API キー
NOTION_API_KEY=

# 報告bot (n8n) と共有するエンジニアタスクDBのID
NOTION_TASKS_DB_ID=

# プロパティ名は src/lib/notion.ts の NOTION_PROPS と一致が必要:
#   名前 / 開発ステータス / 担当者 / スケジュール / 進捗率 / プロジェクト
# プロジェクト slug ↔ Notion 値 は src/data/projects.ts の notionProjectNames
# 担当者の Notion名 → 略号 は src/lib/notion.ts の ASSIGNEE_ALIAS

# ============================================================
# 認証 (NextAuth.js + Google OAuth)
# ============================================================
# 3つ全てセットされた場合に認証モードが有効化されます。
# 未設定時は無認証モード（全機能利用可、開発用）。

# Google Cloud Console > API & Services > Credentials で発行
# Authorized redirect URIs に <deploy-url>/api/auth/callback/google を追加
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `openssl rand -base64 32` などで生成
NEXTAUTH_SECRET=

# 本番デプロイURL (例: https://project-gantt.vercel.app)
# Vercel 環境では VERCEL_URL から自動推定されるため省略可。
# それ以外 (Railway, ローカルでの OAuth テスト 等) では設定推奨。
NEXTAUTH_URL=

# ============================================================
# 権限テーブル（任意）
# ============================================================
# 未設定時は src/lib/permissions.ts の HARDCODED_PERMISSIONS が使われます。
# JSON配列。1行で記述。
# 例:
# AUTH_PERMISSIONS=[{"email":"m.oba@visionary-jp.net","role":"admin"},{"email":"editor@example.com","role":"editor","projects":["ea","dit"]},{"email":"viewer@example.com","role":"viewer","projects":["ea"]}]
AUTH_PERMISSIONS=
